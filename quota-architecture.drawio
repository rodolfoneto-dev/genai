        <mxCell id="e11" value="Sim (Admin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#A855F7;fontColor=#A855F7;fontStyle=1;" edge="1" parent="1" source="role_check" target="admin_bypass_box">
