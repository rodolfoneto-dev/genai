          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="Sim (&gt; 20 req/min)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF4444;fontColor=#EF4444;fontStyle=1;" edge="1" parent="1" source="rl_decision" target="rl_blocked">
