# ==============================================================================
# GenAI Service Environment Variables (:4004)
# ==============================================================================

# Server Configuration
PORT=4004
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/upexperience_genai

# Security & Authentication (Same secret used by auth and academy)
JWT_SECRET=supersecret_staging_jwt_key_please_change

# AI Providers Configuration (Gemini, Claude, OpenCode Zen e DeepSeek)
DEFAULT_AI_PROVIDER=deepseek # 'gemini' | 'claude' | 'opencode' | 'deepseek'
USE_MOCK_AI=false # true para simular respostas localmente com custo $0
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=big-pickle
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# FinOps & Context Window
TUTOR_MAX_CONTEXT_MESSAGES=6 # Tamanho da janela deslizante do chat (padrão: 6 mensagens)

# CORS & Gateway
CORS_ORIGIN=*
